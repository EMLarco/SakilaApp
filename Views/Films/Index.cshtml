@model IEnumerable<SakilaApp.Models.Film>
@{
    ViewData["Title"] = "Películas";
}
<h1>Películas</h1>
<p><a asp-action="Create" class="btn btn-primary">Crear nueva</a></p>
<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Título</th>
            <th>Año</th>
            <th>Duración</th>
            <th>Tarifa</th>
            <th>Clasificación</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.FilmId</td>
                <td>@item.Title</td>
                <td>@item.ReleaseYear</td>
                <td>@(item.Length ?? 0) min</td>
                <td>$@item.RentalRate</td>
                <td>@item.Rating</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.FilmId"
                       class="btn btn-info btn-sm">Detalles</a>
                    <a asp-action="Edit" asp-route-id="@item.FilmId"
                       class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.FilmId"
                       class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>