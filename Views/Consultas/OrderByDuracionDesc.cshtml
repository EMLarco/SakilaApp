@model IEnumerable<SakilaApp.Models.Film>
@{
    ViewData["Title"] = "Películas ordenadas por duración (mayor a menor)";
}

<div class="container mt-4">
    <h1 class="mb-4"><i class="bi bi-hourglass-split"></i> @ViewData["Title"]</h1>

    <div class="table-responsive">
        <table class="table table-striped table-bordered table-hover">
            <thead class="table-primary">
                <tr>
                    <th>Título</th>
                    <th>Duración (min)</th>
                    <th>Año</th>
                    <th>Tarifa</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(m => item.Title)</td>
                        <td>@Html.DisplayFor(m => item.Length)</td>
                        <td>@Html.DisplayFor(m => item.ReleaseYear)</td>
                        <td>@Html.DisplayFor(m => item.RentalRate)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Volver</a>
</div>
