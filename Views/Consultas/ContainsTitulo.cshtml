@model IEnumerable<SakilaApp.Models.Film>
@{
    ViewData["Title"] = $"Películas cuyo título contiene '{ViewBag.Texto}'";
}

<div class="container mt-4">
    <h1 class="mb-4"><i class="bi bi-search-heart"></i> @ViewData["Title"]</h1>

    <div class="table-responsive">
        <table class="table table-striped table-bordered table-hover">
            <thead class="table-primary">
                <tr>
                    <th>Título</th>
                    <th>Descripción</th>
                    <th>Duración (min)</th>
                    <th>Tarifa</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(m => item.Title)</td>
                        <td>@(item.Description?.Length > 80 ? item.Description.Substring(0,80) + "..." : item.Description)</td>
                        <td>@Html.DisplayFor(m => item.Length)</td>
                        <td>@Html.DisplayFor(m => item.RentalRate)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (!Model.Any())
    {
        <div class="alert alert-info" role="alert">
            <i class="bi bi-info-circle"></i> No se encontraron películas con "<strong>@ViewBag.Texto</strong>" en el título.
        </div>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary mt-3"><i class="bi bi-arrow-left"></i> Volver</a>
</div>
