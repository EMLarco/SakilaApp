@model IEnumerable<SakilaApp.Models.Inventory>
@{
    ViewData["Title"] = "Inventarios";
}
<h1>Inventarios</h1>
<p>
    <a asp-action="Create" class="btn btn-primary">
        Crear nuevo
        registro
    </a>
</p>
<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Película ID</th>
            <th>Tienda ID</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.InventoryId</td>
                <td>@item.FilmId</td>
                <td>@item.StoreId</td>
                <td>
                    <a asp-action="Details" asp-routeid="@item.InventoryId" class="btn btn-info btn-sm">Detalles</a>
                    <a asp-action="Edit" asp-route-id="@item.InventoryId"
                       class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.InventoryId"
                       class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>